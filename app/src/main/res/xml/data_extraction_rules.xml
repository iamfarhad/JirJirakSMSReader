<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app leaves the phone by backup or by «move to a new phone». The pairing and the
  manage key are sealed with a Keystore key that stays on this phone, so on another phone they would
  be unreadable; the queue and the event log belong to this phone's SMS. A new phone pairs afresh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
